{
    "name": "crosspad-mixer",
    "version": "0.8.0",
    "description": "CrossPad audio mixer/router with VU meters, routing matrix, channel strips",
    "keywords": [
        "crosspad",
        "mixer",
        "audio",
        "lvgl"
    ],
    "frameworks": [
        "arduino"
    ],
    "platforms": [
        "espressif32"
    ],
    "dependencies": {
        "crosspad-core": "*",
        "crosspad-gui": "*"
    },
    "build": {
        "srcDir": "src",
        "includeDir": "include",
        "appLibrary": true,
        "flags": [
            "-DCROSSPAD_USE_ESP_DSP=1"
        ]
    }
}